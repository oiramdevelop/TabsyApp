frontend/node_modules/
backend/node_modules/

# Ignore Composer / vendor dependency directories
/vendor/
backend/vendor/

# Environment and editor files
.env
.env.*
/.idea
/.vscode
/.phpunit.cache
/.phpactor
.DS_Store
Thumbs.db

# Laravel storage and compiled files
/storage/
/public/storage
/public/build
/public/hot

# Other generated files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
