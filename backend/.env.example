APP_NAME=Tabsy
APP_ENV=local
APP_KEY=
APP_URL=http://localhost
APP_DEBUG=true

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tabsy_db
DB_USERNAME=root
DB_PASSWORD=toor

# Correo: 'log' escribe los correos en storage/logs/laravel.log en vez de
# enviarlos de verdad. Cambia a smtp + rellena MAIL_USERNAME/MAIL_PASSWORD
# (App Password de Gmail) cuando quieras que se envíen de verdad.
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=no-reply@tabsy.local
MAIL_FROM_NAME=Tabsy

SANCTUM_STATEFUL_DOMAINS=localhost

# Stripe (modo test) — claves de https://dashboard.stripe.com/test/apikeys
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
